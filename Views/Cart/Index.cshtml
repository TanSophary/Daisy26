@model List<OnlineShop.Models.CartItem>
@{
    ViewData["Title"] = "My Cart";
    Layout = "~/Views/Shared/_Layout.cshtml";
    decimal total = Model.Sum(i => (i.Product?.Price ?? 0) * i.Quantity);
    decimal shipping = total >= 100 ? 0 : 5;
}

<div class="container cart-page">
    <h1 style="font-family:'Poppins',sans-serif;font-weight:700;margin-bottom:32px">
        <i class="fas fa-shopping-cart me-2" style="color:var(--sky-500)"></i>
        My Cart
        <span class="badge ms-2" style="background:var(--sky-500);font-size:0.9rem;border-radius:50px">
            @Model.Count
        </span>
    </h1>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div style="font-size:5rem;margin-bottom:16px">🛒</div>
            <h3>Your cart is empty</h3>
            <p class="text-muted mb-4">Looks like you haven't added anything yet.</p>
            <a asp-controller="Products" asp-action="Index" class="btn-primary-shop">
                Continue Shopping
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="cart-table">
                    <table>
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th class="text-center">Price</th>
                                <th class="text-center">Qty</th>
                                <th class="text-center">Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="@item.Product?.ImageUrl"
                                                 style="width:70px;height:70px;object-fit:cover;border-radius:10px;border:1px solid var(--border)"
                                                 alt="@item.Product?.Name" />
                                            <div>
                                                <div style="font-weight:700;font-size:0.9rem">@item.Product?.Name</div>
                                                <div style="color:var(--muted);font-size:0.8rem">@item.Product?.Category?.Name</div>
                                                @if (!string.IsNullOrEmpty(item.Color))
                                                {
                                                    <div style="font-size:0.78rem;margin-top:4px">
                                                        <span style="display:inline-flex;align-items:center;gap:5px;background:#fff0f6;border:1.5px solid var(--pink-200);color:var(--pink-700);border-radius:50px;padding:2px 10px;font-weight:600">
                                                            <span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:@item.Color;border:1px solid rgba(0,0,0,0.15);flex-shrink:0"></span>
                                                            @item.Color
                                                        </span>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center" style="font-weight:700;color:var(--sky-600)">
                                        $@item.Product?.Price.ToString("0.00")
                                    </td>
                                    <td class="text-center">
                                        <form asp-action="Update" method="post" class="d-inline">
                                            <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                            <input type="number" name="qty" value="@item.Quantity" min="1" max="99"
                                                   class="qty-input" onchange="this.form.submit()" />
                                        </form>
                                    </td>
                                    <td class="text-center" style="font-weight:700">
                                        $@(((item.Product?.Price ?? 0) * item.Quantity).ToString("0.00"))
                                    </td>
                                    <td>
                                        <form asp-action="Remove" method="post">
                                            <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                            <button type="submit" class="btn btn-sm"
                                                    style="color:var(--muted);border:none;background:none"
                                                    onclick="return confirm('Remove this item?')">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="mt-3">
                    <a asp-controller="Products" asp-action="Index"
                       style="color:var(--sky-600);font-weight:600;font-size:0.9rem">
                        <i class="fas fa-arrow-left me-1"></i> Continue Shopping
                    </a>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="cart-summary">
                    <h4>Order Summary</h4>
                    <div class="summary-row">
                        <span>Subtotal (@Model.Count items)</span>
                        <span>$@total.ToString("0.00")</span>
                    </div>
                    <div class="summary-row">
                        <span>Shipping</span>
                        <span>@(shipping == 0 ? "FREE" : "$" + shipping.ToString("0.00"))</span>
                    </div>
                    @if (shipping > 0)
                    {
                        <div style="font-size:0.8rem;color:var(--teal-600);margin-top:4px">
                            ✓ Add $@((100 - total).ToString("0.00")) more for free shipping!
                        </div>
                    }
                    <div class="summary-row total">
                        <span>Total</span>
                        <span>$@((total + shipping).ToString("0.00"))</span>
                    </div>
                    <a asp-action="Checkout" class="btn-primary-shop w-100 text-center d-block mt-4"
                       style="padding:14px;border-radius:50px">
                        <i class="fas fa-lock me-2"></i>Proceed to Checkout
                    </a>
                </div>
            </div>
        </div>
    }
</div>
