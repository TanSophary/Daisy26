@model OnlineShop.Models.Order
@{
    ViewData["Title"] = "Order Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var statusColor = Model.Status switch {
        "Pending" => "#f59e0b",
        "Processing" => "#3b82f6",
        "Shipped" => "#8b5cf6",
        "Delivered" => "#10b981",
        "Cancelled" => "#ef4444",
        _ => "#6b7280"
    };
}

<div class="container py-5">
    <div class="d-flex align-items-center gap-3 mb-4">
        <a asp-action="MyOrders" class="btn btn-sm" style="background:var(--sky-100);color:var(--sky-600);border:1.5px solid var(--sky-200);border-radius:8px">
            <i class="fas fa-arrow-left me-1"></i>Back
        </a>
        <h2 style="font-family:'Poppins',sans-serif;font-weight:700;margin:0">@Model.OrderNumber</h2>
        <span class="badge rounded-pill px-3 py-2" style="background:@statusColor;font-size:0.85rem">@Model.Status</span>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <!-- Order Items -->
            <div class="bg-white rounded-3 border p-4 mb-4">
                <h5 style="font-family:'Poppins',sans-serif;font-weight:700;color:var(--sky-600);margin-bottom:16px">
                    <i class="fas fa-box me-2"></i>Order Items
                </h5>
                @foreach (var item in Model.OrderItems)
                {
                    <div class="d-flex align-items-center gap-3 py-2 border-bottom">
                        @if (!string.IsNullOrEmpty(item.ProductImage))
                        {
                            <img src="@item.ProductImage" style="width:55px;height:55px;object-fit:cover;border-radius:8px;border:1px solid var(--border)" />
                        }
                        <div class="flex-fill">
                            <div style="font-weight:600;font-size:0.92rem">@item.ProductName</div>
                            @if (!string.IsNullOrEmpty(item.Color))
                            {
                                <div style="font-size:0.75rem;margin-top:3px">
                                    <span style="display:inline-flex;align-items:center;gap:5px;background:#fff0f6;border:1.5px solid var(--pink-200);color:var(--pink-700);border-radius:50px;padding:2px 10px;font-weight:600">
                                        <span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:@item.Color;border:1px solid rgba(0,0,0,0.15);flex-shrink:0"></span>
                                        @item.Color
                                    </span>
                                </div>
                            }
                            <div style="font-size:0.8rem;color:var(--muted)">Qty: @item.Quantity × $@item.UnitPrice.ToString("F2")</div>
                        </div>
                        <span style="font-weight:700;color:var(--sky-600)">$@item.TotalPrice.ToString("F2")</span>
                    </div>
                }
            </div>

            <!-- Map (if location saved) -->
            @if (Model.LocationLat.HasValue && Model.LocationLng.HasValue)
            {
                <div class="bg-white rounded-3 border p-4">
                    <h5 style="font-family:'Poppins',sans-serif;font-weight:700;color:var(--sky-600);margin-bottom:16px">
                        <i class="fas fa-map-marker-alt me-2"></i>Delivery Location
                    </h5>
                    <div id="detailMap" style="width:100%;height:260px;border-radius:12px;border:1.5px solid var(--border);overflow:hidden"></div>
                </div>
                <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyBFw0Qbyq9zTFTd-tUY6dZWTgaQzuU3LKo&callback=initDetailMap" async defer></script>
                <script>
                    function initDetailMap() {
                        const lat = @Model.LocationLat;
                        const lng = @Model.LocationLng;
                        const map = new google.maps.Map(document.getElementById('detailMap'), {
                            center: { lat, lng }, zoom: 15, mapTypeControl: false, streetViewControl: false
                        });
                        new google.maps.Marker({ position: { lat, lng }, map, title: 'Delivery Location' });
                    }
                </script>
            }
        </div>

        <div class="col-lg-4">
            <!-- Order Summary -->
            <div class="bg-white rounded-3 border p-4 mb-3">
                <h5 style="font-family:'Poppins',sans-serif;font-weight:700;color:var(--sky-600);margin-bottom:16px">Summary</h5>
                <div class="d-flex justify-content-between mb-1"><span style="color:var(--muted)">Subtotal</span><span>$@Model.SubTotal.ToString("F2")</span></div>
                @if (Model.Discount > 0)
                {
                    <div class="d-flex justify-content-between mb-1 text-success"><span>Discount</span><span>-$@Model.Discount.ToString("F2")</span></div>
                }
                <div class="d-flex justify-content-between mb-1"><span style="color:var(--muted)">Shipping</span><span>$@Model.ShippingFee.ToString("F2")</span></div>
                <hr style="border-color:var(--border)" />
                <div class="d-flex justify-content-between fw-bold" style="color:var(--sky-600);font-size:1.05rem">
                    <span>Total</span><span>$@Model.Total.ToString("F2")</span>
                </div>
                <div class="mt-3 pt-3 border-top">
                    <div style="font-size:0.85rem"><strong>Payment:</strong> @Model.PaymentMethod</div>
                    <div style="font-size:0.85rem"><strong>Ordered:</strong> @Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</div>
                </div>
            </div>

            <!-- Shipping Info -->
            <div class="bg-white rounded-3 border p-4 mb-3">
                <h5 style="font-family:'Poppins',sans-serif;font-weight:700;color:var(--sky-600);margin-bottom:12px">Shipping Info</h5>
                <div style="font-size:0.88rem"><strong>Name:</strong> @Model.ShipName</div>
                <div style="font-size:0.88rem"><strong>Phone:</strong> @Model.ShipPhone</div>
                <div style="font-size:0.88rem"><strong>Address:</strong> @Model.ShipAddress</div>
                @if (!string.IsNullOrEmpty(Model.Note))
                {
                    <div style="font-size:0.88rem"><strong>Note:</strong> @Model.Note</div>
                }
            </div>

            <!-- Contact Seller -->
            <div class="rounded-3 p-3" style="background:var(--sky-50);border:1px solid var(--sky-100)">
                <div style="font-size:0.85rem;font-weight:700;color:var(--sky-700);margin-bottom:8px">
                    <i class="fas fa-headset me-1"></i>Need Help?
                </div>
                <div style="font-size:0.85rem">📱 <strong>0979534329</strong></div>
                <div style="font-size:0.85rem">✈️ <a href="https://t.me/Pha_Rie" target="_blank" style="color:var(--sky-600);font-weight:600">@@Pha_Rie</a> on Telegram</div>
            </div>
        </div>
    </div>
</div>
