<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Daisy 26</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- ===== NAVBAR ===== -->
    <nav class="navbar navbar-shop navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <i class="fas fa-shopping-bag me-2"></i>Daisy<span>26</span>
            </a>

            <div class="search-bar">
                <form asp-controller="Products" asp-action="Index" method="get">
                    <div class="input-group">
                        <input type="text" class="form-control" name="search"
                               placeholder="Search bags, wallets, accessories..." value="@ViewBag.Search" />
                        <button type="submit"><i class="fas fa-search"></i></button>
                    </div>
                </form>
            </div>

            <button class="navbar-toggler border-0 text-danger" type="button"
                    data-bs-toggle="collapse" data-bs-target="#navMenu">
                <i class="fas fa-bars"></i>
            </button>

            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav ms-auto align-items-lg-center">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <i class="fas fa-home me-1"></i> Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Products" asp-action="Index">
                            <i class="fas fa-shopping-bag me-1"></i> Collection
                        </a>
                    </li>
                    @if (Context.Session.GetString("UserId") != null)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Cart" asp-action="MyOrders">
                                <i class="fas fa-box me-1"></i> My Orders
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" style="font-weight:600">
                                <i class="fas fa-user-circle me-1"></i>@Context.Session.GetString("UserName")
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                @* <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="fas fa-user me-2"></i>Profile</a></li> *@
                                <li><a class="dropdown-item" asp-controller="Cart" asp-action="MyOrders"><i class="fas fa-box me-2"></i>My Orders</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout"><i class="fas fa-sign-out-alt me-2"></i>Logout</a></li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">
                                <i class="fas fa-sign-in-alt me-1"></i> Login
                            </a>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link cart-icon" asp-controller="Cart" asp-action="Index">
                            <i class="fas fa-shopping-cart"></i>
                            <span class="badge">@(ViewBag.CartCount ?? 0)</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    @if (TempData["Success"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-shop alert-success-shop d-flex align-items-center gap-2">
                <i class="fas fa-check-circle"></i> @TempData["Success"]
            </div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-danger d-flex align-items-center gap-2" style="border-radius:12px;border:none;border-left:4px solid #ef4444">
                <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
            </div>
        </div>
    }

    @RenderBody()

    <!-- ===== FOOTER ===== -->
    <footer class="footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="footer-logo">Daisy<span>26</span></div>
                    <p class="mt-3" style="font-size:0.9rem;line-height:1.8">
                        Your premier destination for elegant bags, wallets & accessories.
                        Curated collections for every style & occasion.
                    </p>
                    <div class="social-links">
                        <a href="#"><i class="fab fa-facebook-f"></i></a>
                        <a href="#"><i class="fab fa-instagram"></i></a>
                        <a href="#"><i class="fab fa-telegram"></i></a>
                        <a href="#"><i class="fab fa-tiktok"></i></a>
                    </div>
                </div>
                <div class="col-6 col-lg-2">
                    <h5>Shop</h5>
                    <a asp-controller="Products" asp-action="Index">All Bags</a>
                    <a asp-controller="Products" asp-action="Index" asp-route-sort="newest">New Arrivals</a>
                    <a asp-controller="Products" asp-action="Index" asp-route-sort="rating">Best Sellers</a>
                    <a href="#">Sale Items</a>
                </div>
                <div class="col-6 col-lg-2">
                    <h5>Support</h5>
                    <a href="#">Help Center</a>
                    <a href="#">Track Order</a>
                    <a href="#">Return Policy</a>
                    <a href="#">Contact Us</a>
                </div>
                <div class="col-lg-4">
                    <h5>Contact Us</h5>
                    <p style="font-size:0.9rem;line-height:1.9;color:rgba(255,255,255,0.7)">
                        <i class="fas fa-map-marker-alt me-2"></i>Phnom Penh, Cambodia<br>
                        <i class="fas fa-phone me-2"></i>+855 979 534 329<br>
                        <i class="fas fa-envelope me-2"></i>tansophary@gmail.com<br>
                        <i class="fas fa-clock me-2"></i>Mon–Sun, 24h
                    </p>
                </div>
            </div>
            <div class="footer-bottom">
                <i class="fas fa-shopping-bag me-2"></i>Daisy<span>26</span>
                <div class="footer-logo">Daisy<span>26</span></div>
                <p>&copy; @DateTime.Now.Year Daisy 26. All rights reserved. Made with 🌼 in Cambodia.</p>
            </div>
        </div>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>