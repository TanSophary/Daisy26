@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Customers";
    ViewData["Page"] = "Customers";
    var customers = ViewBag.Customers as IEnumerable<OnlineShop.Models.Customer> ?? new List<OnlineShop.Models.Customer>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold m-0" style="color:var(--pink-700)"><i class="fas fa-users me-2"></i>Customers</h4>
    <form asp-action="Customers" method="get" class="d-flex gap-2">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm rounded-pill" placeholder="Search name or email..." style="width:220px" />
        <button type="submit" class="btn btn-sm rounded-pill text-white" style="background:var(--pink-500)"><i class="fas fa-search"></i></button>
    </form>
</div>

<div class="table-responsive bg-white rounded-3 shadow-sm">
    <table class="table table-hover align-middle mb-0">
        <thead style="background:#ff4da6;color:#fff">
            <tr>
                <th class="px-4 py-3">#</th>
                <th class="py-3">Card Code</th>
                <th class="py-3">Name</th>
                <th class="py-3">Email</th>
                <th class="py-3">Phone</th>
                <th class="py-3">Joined</th>
                <th class="py-3">Status</th>
                <th class="py-3 pe-4">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in customers)
            {
                <tr>
                    <td class="px-4 text-muted fw-bold">#@c.CustomerId</td>
                    <td><span style="font-family:monospace;font-weight:700;color:var(--pink-600)">@c.CardCode</span></td>
                    <td class="fw-bold">@c.FullName</td>
                    <td style="font-size:.88rem">@c.Email</td>
                    <td style="font-size:.88rem">@(c.Phone ?? "—")</td>
                    <td style="font-size:.83rem;color:var(--muted)">@c.CreatedAt.ToString("dd MMM yyyy")</td>
                    <td>
                        @if (c.IsActive)
                        {
                            <span class="badge bg-success rounded-pill px-3">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger rounded-pill px-3">Blocked</span>
                        }
                    </td>
                    <td class="pe-4">
                        <form asp-action="ToggleCustomer" asp-route-id="@c.CustomerId" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm rounded-pill px-3 @(c.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                    style="font-size:.82rem">
                                @(c.IsActive ? "Block" : "Unblock")
                            </button>
                        </form>
                    </td>
                </tr>
            }
            @if (!customers.Any())
            {
                <tr><td colspan="8" class="text-center py-5 text-muted">No customers found.</td></tr>
            }
        </tbody>
    </table>
</div>
