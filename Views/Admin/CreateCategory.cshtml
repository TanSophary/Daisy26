@model OnlineShop.Models.Category
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Add New Category";
    ViewData["Page"] = "Categories";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="bg-white rounded-3 shadow-sm p-4">
            <h5 class="fw-bold mb-4" style="color:var(--pink-700)"><i class="fas fa-plus-circle me-2"></i>Add New Category</h5>
            <form asp-action="CreateCategory" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" style="font-size:.88rem"></div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Category Name *</label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Handbags" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Short description..."></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Image URL</label>
                    <input asp-for="ImageUrl" class="form-control" placeholder="https://..." />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Sort Order</label>
                    <input asp-for="SortOrder" type="number" class="form-control" value="0" />
                </div>
                <div class="mb-4 form-check">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                    <label asp-for="IsActive" class="form-check-label fw-bold">Active</label>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn text-white fw-bold rounded-pill px-4"
                            style="background:#ff4da6">
                        <i class="fas fa-save me-1"></i>Save Category
                    </button>
                    <a asp-action="Categories" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
