@model OnlineShop.Models.Coupon
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit Coupon";
    ViewData["Page"] = "Coupons";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="bg-white rounded-3 shadow-sm p-4">
            <h5 class="fw-bold mb-4" style="color:var(--pink-700)"><i class="fas fa-edit me-2"></i>Edit Coupon</h5>
            <form asp-action="EditCoupon" asp-route-id="@Model.CouponId" method="post">
                <div class="mb-3">
                    <label class="form-label fw-bold">Coupon Code *</label>
                    <input asp-for="Code" class="form-control" style="font-family:monospace;letter-spacing:2px;text-transform:uppercase" required />
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label class="form-label fw-bold">Discount Type</label>
                        <select asp-for="DiscountType" class="form-select">
                            <option>Percent</option>
                            <option>Fixed</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-bold">Value</label>
                        <input asp-for="DiscountValue" type="number" step="0.01" class="form-control" required />
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label class="form-label fw-bold">Min Order Amount</label>
                        <input asp-for="MinOrderAmt" type="number" step="0.01" class="form-control" />
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-bold">Usage Limit <span style="font-weight:400;color:#6b7280">(leave blank or 0 = unlimited)</span></label>
                        <input asp-for="UsageLimit" type="number" min="0" class="form-control" placeholder="0 = unlimited" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Expiry Date</label>
                    <input asp-for="ExpiryDate" type="date" class="form-control" />
                </div>
                <div class="mb-4 form-check">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                    <label asp-for="IsActive" class="form-check-label fw-bold">Active</label>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn text-white fw-bold rounded-pill px-4"
                            style="background:#ff4da6">
                        <i class="fas fa-save me-1"></i>Update Coupon
                    </button>
                    <a asp-action="Coupons" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
