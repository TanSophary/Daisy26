@model IEnumerable<OnlineShop.Models.Category>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Categories";
    ViewData["Page"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold m-0" style="color:var(--pink-700)">
        <i class="fas fa-tags me-2"></i>Categories <span class="badge bg-pink ms-2" style="background:var(--pink-500);font-size:.75rem">@Model.Count()</span>
    </h4>
    <a asp-action="CreateCategory" class="btn btn-sm px-4 py-2 text-white fw-bold rounded-pill"
       style="background:#ff4da6">
        <i class="fas fa-plus me-1"></i>Add Category
    </a>
</div>

<div class="table-responsive bg-white rounded-3 shadow-sm">
    <table class="table table-hover align-middle mb-0">
        <thead style="background:#ff4da6;color:#fff">
            <tr>
                <th class="px-4 py-3">#</th>
                <th class="py-3">Image</th>
                <th class="py-3">Code</th>
                <th class="py-3">Name</th>
                <th class="py-3">Description</th>
                <th class="py-3">Products</th>
                <th class="py-3">Sort</th>
                <th class="py-3">Status</th>
                <th class="py-3 text-end pe-4">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cat in Model)
            {
                <tr>
                    <td class="px-4 text-muted fw-bold">#@cat.CategoryId</td>
                    <td>
                        @if (!string.IsNullOrEmpty(cat.ImageUrl))
                        {
                            <img src="@cat.ImageUrl" alt="@cat.Name" style="width:48px;height:48px;object-fit:cover;border-radius:8px;" onerror="this.style.display='none'" />
                        }
                        else
                        {
                            <div style="width:48px;height:48px;background:var(--pink-100);border-radius:8px;display:flex;align-items:center;justify-content:center">
                                <i class="fas fa-tag" style="color:var(--pink-400)"></i>
                            </div>
                        }
                    </td>
                    <td><span style="font-family:monospace;font-weight:700;color:var(--pink-600)">@cat.CategoryCode</span></td>
                    <td class="fw-bold">@cat.Name</td>
                    <td style="font-size:.88rem;color:var(--muted);max-width:200px">
                        @(string.IsNullOrEmpty(cat.Description) ? "—" : cat.Description.Length > 60 ? cat.Description[..60] + "…" : cat.Description)
                    </td>
                    <td>
                        <span class="badge rounded-pill" style="background:var(--pink-100);color:var(--pink-700);padding:6px 12px;font-size:.82rem">
                            @(cat.Products?.Count() ?? 0) items
                        </span>
                    </td>
                    <td class="fw-bold">@cat.SortOrder</td>
                    <td>
                        @if (cat.IsActive)
                        {
                            <span class="badge bg-success rounded-pill px-3">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary rounded-pill px-3">Inactive</span>
                        }
                    </td>
                    <td class="text-end pe-4">
                        <a asp-action="EditCategory" asp-route-id="@cat.CategoryId"
                           class="btn btn-sm btn-outline-primary rounded-pill me-1" style="border-color:var(--pink-400);color:var(--pink-600)">
                            <i class="fas fa-edit me-1"></i>Edit
                        </a>
                        <form asp-action="DeleteCategory" asp-route-id="@cat.CategoryId" method="post" class="d-inline"
                              onsubmit="return confirm('Delete this category?')">
                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="9" class="text-center py-5 text-muted">No categories yet. <a asp-action="CreateCategory">Add one</a></td></tr>
            }
        </tbody>
    </table>
</div>
