@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var recentOrders = ViewBag.RecentOrders as List<OnlineShop.Models.Order> ?? new();
    var lowStock = ViewBag.LowStock as List<OnlineShop.Models.Product> ?? new();
}

<!-- STAT CARDS -->
<div class="row g-4 mb-4">
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon sky"><i class="fas fa-shopping-bag"></i></div>
            <div>
                <div class="stat-value">@ViewBag.TotalProducts</div>
                <div class="stat-label">Total Products</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon teal"><i class="fas fa-receipt"></i></div>
            <div>
                <div class="stat-value">@ViewBag.TotalOrders</div>
                <div class="stat-label">Total Orders</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon amber"><i class="fas fa-users"></i></div>
            <div>
                <div class="stat-value">@ViewBag.TotalCustomers</div>
                <div class="stat-label">Customers</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon rose"><i class="fas fa-dollar-sign"></i></div>
            <div>
                <div class="stat-value">$@(((decimal)ViewBag.TotalRevenue).ToString("N0"))</div>
                <div class="stat-label">Total Revenue</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- RECENT ORDERS -->
    <div class="col-lg-8">
        <div class="admin-card">
            <div class="admin-card-header">
                <div class="admin-card-title"><i class="fas fa-receipt me-2" style="color:var(--sky-500)"></i>Recent Orders</div>
                <a asp-action="Orders" class="btn-admin-outline">View All</a>
            </div>
            <div style="overflow-x:auto">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Order #</th>
                            <th>Customer</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in recentOrders)
                        {
                            <tr>
                                <td><span style="font-weight:700;color:var(--sky-600)">@o.OrderNumber</span></td>
                                <td>@o.ShipName</td>
                                <td style="font-weight:700">$@o.Total.ToString("0.00")</td>
                                <td>
                                    <span class="badge-status badge-@o.Status.ToLower()">@o.Status</span>
                                </td>
                                <td style="color:var(--muted);font-size:0.82rem">@o.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <a asp-action="OrderDetail" asp-route-id="@o.OrderId" class="btn-view">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- LOW STOCK -->
    <div class="col-lg-4">
        <div class="admin-card">
            <div class="admin-card-header">
                <div class="admin-card-title">
                    <i class="fas fa-exclamation-triangle me-2" style="color:#f59e0b"></i>Low Stock
                </div>
            </div>
            @if (!lowStock.Any())
            {
                <div class="p-4 text-center" style="color:var(--muted)">All products well stocked ✓</div>
            }
            else
            {
                <div style="overflow-x:auto">
                    <table class="admin-table">
                        <thead><tr><th>Product</th><th>Stock</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var p in lowStock)
                            {
                                <tr>
                                    <td style="font-size:0.83rem;font-weight:600">@p.Name</td>
                                    <td>
                                        <span class="badge-status" style="background:#fff7ed;color:#c2410c">
                                            @p.Stock left
                                        </span>
                                    </td>
                                    <td>
                                        <a asp-action="EditProduct" asp-route-id="@p.ProductId" class="btn-edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- QUICK ACTIONS -->
        <div class="admin-card mt-4 p-4">
            <div class="admin-card-title mb-3">
                <i class="fas fa-bolt me-2" style="color:var(--sky-500)"></i>Quick Actions
            </div>
            <div class="d-flex flex-column gap-2">
                <a asp-action="CreateProduct" class="btn-admin-primary w-100 justify-content-center">
                    <i class="fas fa-plus"></i> Add New Product
                </a>
                <a asp-action="CreateCategory" class="btn-admin-outline w-100 justify-content-center">
                    <i class="fas fa-folder-plus"></i> Add Category
                </a>
                <a asp-action="CreateCoupon" class="btn-admin-outline w-100 justify-content-center">
                    <i class="fas fa-ticket-alt"></i> Create Coupon
                </a>
            </div>
        </div>
    </div>
</div>