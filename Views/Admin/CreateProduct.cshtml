@model OnlineShop.Models.Product
@{
    ViewData["Title"] = "Add New Product";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var categories = ViewBag.Categories as List<OnlineShop.Models.Category> ?? new();
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a asp-action="Products" class="btn-admin-outline"><i class="fas fa-arrow-left"></i> Back</a>
    <h1 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:1.4rem;margin:0">
        Add New Bag / Product
    </h1>
</div>

<form asp-action="CreateProduct" method="post" enctype="multipart/form-data">
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="admin-form-card" style="max-width:100%">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label-admin">Product Name *</label>
                        <input asp-for="Name" class="form-control-admin" placeholder="e.g. Sky Daisy Leather Tote Bag" />
                        <span asp-validation-for="Name" style="color:#ef4444;font-size:0.8rem"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label-admin">Category *</label>
                        <select asp-for="CategoryId" class="form-control-admin">
                            <option value="">-- Select Category --</option>
                            @foreach (var c in categories)
                            {
                                <option value="@c.CategoryId">@c.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label-admin">Product Code</label>
                        <input id="productCodePreview" class="form-control-admin" readonly
                               style="background:#f9fafb;color:var(--sky-600);font-family:monospace;font-weight:700"
                               value="Select a category first" />
                        <div style="font-size:0.75rem;color:var(--muted);margin-top:3px">Auto-generated from category</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label-admin">Price (USD) *</label>
                        <input asp-for="Price" type="number" step="0.01" class="form-control-admin" placeholder="0.00" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label-admin">Old Price (optional)</label>
                        <input asp-for="OldPrice" type="number" step="0.01" class="form-control-admin" placeholder="0.00" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label-admin">Stock Quantity *</label>
                        <input asp-for="Stock" type="number" class="form-control-admin" placeholder="Auto-calculated from colors" id="stockField" readonly style="background:#f9fafb;color:var(--muted)" />
                        <div style="font-size:0.75rem;color:var(--muted);margin-top:3px">Calculated from color stocks above</div>
                    </div>
                    <div class="col-12">
                        <label class="form-label-admin">Description</label>
                        <textarea asp-for="Description" class="form-control-admin" rows="4"
                                  placeholder="Describe this bag — material, size, features..."></textarea>
                    </div>

                    <!-- COLORS WITH STOCK -->
                    <div class="col-12">
                        <label class="form-label-admin">Colors & Stock Per Color</label>
                        <div id="colorStockList" style="display:flex;flex-direction:column;gap:8px;margin-bottom:8px"></div>
                        <button type="button" onclick="addColorRow()" class="btn btn-sm"
                                style="background:var(--sky-50);color:var(--sky-600);border:1.5px dashed var(--sky-300);border-radius:8px;font-weight:600;font-size:0.82rem">
                            <i class="fas fa-plus me-1"></i>Add Color
                        </button>
                        <div style="font-size:0.78rem;color:var(--muted);margin-top:6px">
                            Add each color and its stock qty. Total stock is calculated automatically.
                        </div>
                        <!-- Hidden fields populated by JS -->
                        <div id="colorHiddenFields"></div>
                        <div style="margin-top:10px;font-weight:700;font-size:0.85rem">
                            Total Stock: <span id="totalStockDisplay" style="color:var(--sky-600)">0</span>
                        </div>
                    </div>

                    <!-- MAIN IMAGE FILE -->
                    <div class="col-12">
                        <label class="form-label-admin">Main Image *</label>
                        <div class="file-upload-area" id="mainFileArea" onclick="document.getElementById('mainImageFile').click()"
                             style="border:2px dashed var(--border);border-radius:12px;padding:24px;text-align:center;cursor:pointer;background:var(--sky-50);transition:border-color .2s">
                            <i class="fas fa-cloud-upload-alt" style="font-size:2rem;color:var(--sky-400);margin-bottom:8px"></i>
                            <div style="font-weight:600;color:var(--dark)">Click to choose main image</div>
                            <div style="font-size:0.78rem;color:var(--muted);margin-top:4px">JPG, PNG, WEBP — max 5MB</div>
                        </div>
                        <input type="file" name="mainImageFile" id="mainImageFile" accept="image/*" style="display:none"
                               onchange="previewMainFile(this)" />
                        <div style="font-size:0.78rem;color:var(--muted);margin-top:4px">This is the primary product image shown in listings.</div>
                    </div>

                    <!-- ADDITIONAL IMAGES -->
                    <div class="col-12">
                        <label class="form-label-admin">Additional Images</label>
                        <div id="extraFilesContainer"></div>
                        <button type="button" onclick="addExtraFileInput()" class="btn btn-sm mt-1"
                                style="background:var(--sky-50);color:var(--sky-600);border:1.5px dashed var(--sky-300);border-radius:8px;font-weight:600;font-size:0.82rem">
                            <i class="fas fa-plus me-1"></i>Add Another Image
                        </button>
                        <div style="font-size:0.78rem;color:var(--muted);margin-top:4px">Add up to 8 extra images for the product gallery.</div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label-admin">Rating (0–5)</label>
                        <input asp-for="Rating" type="number" step="0.1" min="0" max="5" class="form-control-admin" value="0" />
                    </div>
                    <div class="col-md-4 d-flex align-items-center gap-3 mt-4">
                        <label class="d-flex align-items-center gap-2" style="cursor:pointer;font-weight:700">
                            <input asp-for="IsFeatured" type="checkbox" style="width:18px;height:18px;accent-color:var(--sky-500)" />
                            Featured Product
                        </label>
                    </div>
                    <div class="col-md-4 d-flex align-items-center gap-3 mt-4">
                        <label class="d-flex align-items-center gap-2" style="cursor:pointer;font-weight:700">
                            <input asp-for="IsActive" type="checkbox" checked style="width:18px;height:18px;accent-color:var(--sky-500)" />
                            Active (Visible)
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- MAIN IMAGE PREVIEW -->
            <div class="admin-form-card p-4 text-center mb-4" style="max-width:100%">
                <div class="form-label-admin mb-3">Image Preview</div>
                <img id="mainImgPreview" src="https://via.placeholder.com/250x250?text=No+Image"
                     style="width:100%;max-width:250px;height:220px;object-fit:cover;border-radius:12px;border:2px dashed var(--border)"
                     alt="Preview" />

                <div class="form-label-admin mt-4 mb-2 text-start" style="font-size:0.82rem">Gallery Preview</div>
                <div id="galleryPreview" class="d-flex flex-wrap gap-2 justify-content-start">
                    <div style="color:var(--muted);font-size:0.8rem;text-align:left">Add images above to preview gallery</div>
                </div>
            </div>

            <!-- SUBMIT -->
            <div class="admin-form-card p-4" style="max-width:100%">
                <button type="submit" class="btn-admin-primary w-100 justify-content-center mb-2"
                        style="padding:14px;font-size:1rem">
                    <i class="fas fa-save me-2"></i>Save Product
                </button>
                <a asp-action="Products" class="btn-admin-outline w-100 justify-content-center"
                   style="padding:12px">
                    <i class="fas fa-times me-2"></i>Cancel
                </a>
            </div>
        </div>
    </div>
</form>

<script>
    let extraCount = 0;
    const allPreviews = [];

    function previewMainFile(input) {
        if (!input.files || !input.files[0]) return;
        const file = input.files[0];
        const url = URL.createObjectURL(file);
        document.getElementById('mainImgPreview').src = url;
        allPreviews[0] = url;
        // Update upload area label
        document.getElementById('mainFileArea').innerHTML = `
            <i class="fas fa-check-circle" style="font-size:1.5rem;color:#22c55e;margin-bottom:6px"></i>
            <div style="font-weight:600;color:var(--dark)">${file.name}</div>
            <div style="font-size:0.78rem;color:var(--muted)">Click to change</div>`;
        refreshGallery();
    }

    function addExtraFileInput() {
        const container = document.getElementById('extraFilesContainer');
        const rows = container.querySelectorAll('.extra-file-row');
        if (rows.length >= 8) { alert('Maximum 8 additional images.'); return; }
        const idx = ++extraCount;
        const div = document.createElement('div');
        div.className = 'extra-file-row d-flex gap-2 mb-2 align-items-center';
        div.setAttribute('data-idx', idx);
        div.innerHTML = `
            <label class="d-flex align-items-center gap-2 flex-grow-1" style="border:1.5px dashed var(--border);border-radius:8px;padding:8px 12px;cursor:pointer;background:#fff;min-width:0">
                <i class="fas fa-image" style="color:var(--sky-400)"></i>
                <span class="extra-label-${idx}" style="font-size:0.85rem;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">Choose image ${rows.length + 2}</span>
                <input type="file" name="extraImageFiles" accept="image/*" style="display:none"
                       onchange="previewExtraFile(this, ${idx})" />
            </label>
            <button type="button" onclick="removeExtraRow(this, ${idx})" class="btn btn-sm" style="background:#fee2e2;color:#991b1b;border-radius:8px;flex-shrink:0">
                <i class="fas fa-times"></i>
            </button>`;
        container.appendChild(div);
    }

    function previewExtraFile(input, idx) {
        if (!input.files || !input.files[0]) return;
        const file = input.files[0];
        const url = URL.createObjectURL(file);
        allPreviews[idx] = url;
        const label = document.querySelector(`.extra-label-${idx}`);
        if (label) label.textContent = file.name;
        refreshGallery();
    }

    function removeExtraRow(btn, idx) {
        btn.closest('.extra-file-row').remove();
        delete allPreviews[idx];
        refreshGallery();
    }

    // ── Color Stock rows ──────────────────────────────────
    let colorRowCount = 0;

    function addColorRow(name = '', stock = 0) {
        const list = document.getElementById('colorStockList');
        const idx = ++colorRowCount;
        const div = document.createElement('div');
        div.className = 'color-stock-row';
        div.setAttribute('data-idx', idx);
        div.style.cssText = 'display:flex;gap:8px;align-items:center';
        div.innerHTML = `
            <input type="text" placeholder="Color name (e.g. Red)" value="${name}"
                   class="form-control-admin" style="flex:1;min-width:120px"
                   oninput="syncColorFields()" />
            <input type="number" placeholder="Stock" value="${stock}" min="0"
                   class="form-control-admin" style="width:90px"
                   oninput="syncColorFields()" />
            <button type="button" onclick="removeColorRow(this)"
                    class="btn btn-sm" style="background:#fee2e2;color:#991b1b;border-radius:8px;flex-shrink:0">
                <i class="fas fa-times"></i>
            </button>`;
        list.appendChild(div);
        syncColorFields();
    }

    function removeColorRow(btn) {
        btn.closest('.color-stock-row').remove();
        syncColorFields();
    }

    function syncColorFields() {
        const rows = document.querySelectorAll('.color-stock-row');
        const hidden = document.getElementById('colorHiddenFields');
        hidden.innerHTML = '';
        let total = 0;
        rows.forEach(row => {
            const inputs = row.querySelectorAll('input');
            const name = inputs[0].value.trim();
            const qty = parseInt(inputs[1].value) || 0;
            if (name) {
                hidden.innerHTML += `<input type="hidden" name="colorNames" value="${name}" />`;
                hidden.innerHTML += `<input type="hidden" name="colorStocks" value="${qty}" />`;
                total += qty;
            }
        });
        document.getElementById('totalStockDisplay').textContent = total;
        const sf = document.getElementById('stockField');
        if (sf) sf.value = total;
    }
    // ─────────────────────────────────────────────────────

    // ── ProductCode preview ───────────────────────────────────
    document.addEventListener('DOMContentLoaded', function() {
        var catSelect = document.querySelector('select[name="CategoryId"]');
        if (catSelect) {
            catSelect.addEventListener('change', fetchCodePreview);
            if (catSelect.value) fetchCodePreview();
        }
    });

    function fetchCodePreview() {
        var catSelect = document.querySelector('select[name="CategoryId"]');
        var preview = document.getElementById('productCodePreview');
        if (!catSelect || !preview || !catSelect.value) return;
        fetch('/Admin/PreviewProductCode?categoryId=' + catSelect.value)
            .then(r => r.json())
            .then(d => { preview.value = d.code; })
            .catch(() => { preview.value = 'Error'; });
    }
    // ─────────────────────────────────────────────────────────

    function refreshGallery() {
        const urls = allPreviews.filter(Boolean);
        const container = document.getElementById('galleryPreview');
        if (!urls.length) {
            container.innerHTML = '<div style="color:var(--muted);font-size:0.8rem">Add images above to preview gallery</div>';
            return;
        }
        container.innerHTML = urls.map((url, i) => `
            <div style="position:relative">
                <img src="${url}" style="width:58px;height:58px;object-fit:cover;border-radius:8px;border:2px solid ${i===0 ? 'var(--pink-500)' : 'var(--border)'}" />
                ${i===0 ? '<span style="position:absolute;top:2px;left:2px;background:var(--pink-500);color:#fff;font-size:0.55rem;padding:1px 4px;border-radius:4px;font-weight:700">MAIN</span>' : ''}
            </div>`).join('');
    }
</script>
