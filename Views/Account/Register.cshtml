@{
    Layout = "_Layout";
    ViewData["Title"] = "Register";
}
<div class="auth-page">
    <div class="container">
        <div class="auth-card" style="max-width:520px">
            <div class="auth-logo">Pink<span>Daisy</span></div>
            <h2 class="text-center mb-1">Create Account</h2>
            <p class="text-center text-muted mb-4" style="font-size:.9rem">Join us and start shopping</p>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger rounded-3 border-0 border-start border-danger border-4 py-2 px-3 mb-3" style="font-size:.9rem">
                    <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                </div>
            }

            <form method="post" asp-action="Register">
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                <div class="mb-3">
                    <label class="form-label fw-bold">Full Name *</label>
                    <input type="text" name="fullName" class="form-control" placeholder="Your full name" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Email Address *</label>
                    <input type="email" name="email" class="form-control" placeholder="you@example.com" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Phone Number</label>
                    <input type="tel" name="phone" class="form-control" placeholder="+855 12 345 678" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Password *</label>
                    <input type="password" name="password" class="form-control" placeholder="Min 6 characters" required minlength="6" />
                </div>
                <div class="mb-4">
                    <label class="form-label fw-bold">Confirm Password *</label>
                    <input type="password" name="confirmPassword" class="form-control" placeholder="Repeat password" required />
                </div>
                <button type="submit" class="btn-primary-shop w-100">
                    <i class="fas fa-user-plus me-2"></i>Create Account
                </button>
            </form>

            <hr class="my-4" />
            <p class="text-center text-muted" style="font-size:.9rem">
                Already have an account?
                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" class="fw-bold text-decoration-none" style="color:var(--pink-600)">
                    Login here
                </a>
            </p>
        </div>
    </div>
</div>
