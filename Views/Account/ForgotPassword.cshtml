@{
    Layout = "_Layout";
    ViewData["Title"] = "Forgot Password";
}
<div class="auth-page">
    <div class="container">
        <div class="auth-card">
            <div class="auth-logo">Pink<span>Daisy</span></div>
            <h2 class="text-center mb-1">Forgot Password</h2>
            <p class="text-center text-muted mb-4" style="font-size:.9rem">Enter your email and we'll send you a 6-digit OTP</p>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger rounded-3 border-0 border-start border-danger border-4 py-2 px-3 mb-3" style="font-size:.9rem">
                    <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                </div>
            }
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success rounded-3 border-0 border-start border-success border-4 py-2 px-3 mb-3" style="font-size:.9rem">
                    <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                </div>
            }
            @if (TempData["OtpCode"] != null)
            {
                <div class="alert alert-warning rounded-3 p-3 mb-3 text-center" style="font-size:.9rem">
                    <div style="font-size:.78rem;color:#92400e;margin-bottom:4px">⚠️ Development mode — remove TempData["OtpCode"] in production</div>
                    <div style="font-size:2rem;font-weight:800;letter-spacing:8px;color:#92400e">@TempData["OtpCode"]</div>
                    <div style="font-size:.78rem;color:#92400e">Valid for 10 minutes</div>
                </div>
            }

            <form method="post" asp-action="ForgotPassword">
                <div class="mb-3">
                    <label class="form-label fw-bold">Email Address</label>
                    <input type="email" name="email" class="form-control" placeholder="you@example.com" required />
                </div>
                <button type="submit" class="btn-primary-shop w-100 mt-2">
                    <i class="fas fa-paper-plane me-2"></i>Send OTP Code
                </button>
            </form>

            <hr class="my-4" />
            <p class="text-center text-muted" style="font-size:.9rem">
                Remember your password?
                <a asp-controller="Account" asp-action="Login" class="fw-bold text-decoration-none" style="color:var(--pink-600)">
                    Back to Login
                </a>
            </p>
        </div>
    </div>
</div>
