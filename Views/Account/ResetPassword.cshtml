@{
    Layout = "_Layout";
    ViewData["Title"] = "Reset Password";
}
<div class="auth-page">
    <div class="container">
        <div class="auth-card">
            <div class="auth-logo">Pink<span>Daisy</span></div>
            <h2 class="text-center mb-1">Reset Password</h2>
            <p class="text-center text-muted mb-4" style="font-size:.9rem">Enter your new password below</p>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger rounded-3 border-0 border-start border-danger border-4 py-2 px-3 mb-3" style="font-size:.9rem">
                    <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                </div>
            }

            <form method="post" asp-action="ResetPassword">
                <input type="hidden" name="token" value="@ViewBag.Token" />
                <div class="mb-3">
                    <label class="form-label fw-bold">New Password</label>
                    <input type="password" name="password" class="form-control" placeholder="••••••••" required minlength="6" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Confirm New Password</label>
                    <input type="password" name="confirmPassword" class="form-control" placeholder="••••••••" required minlength="6" />
                </div>
                <button type="submit" class="btn-primary-shop w-100 mt-2">
                    <i class="fas fa-key me-2"></i>Reset Password
                </button>
            </form>
        </div>
    </div>
</div>
